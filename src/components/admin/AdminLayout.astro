---
import "../../styles/global.css";
import { getAdminFromCookies } from "../../lib/auth";
import {
  FolderTree,
  LayoutDashboard,
  LogOut,
  Package,
  ShoppingCart,
  Users,
} from "lucide-react";

const admin = await getAdminFromCookies(Astro.cookies);

interface Props {
  title: string;
}
const { title } = Astro.props;

const nav = [
  { href: "/admin", label: "Dashboard", icon: LayoutDashboard },
  { href: "/admin/productos", label: "Productos", icon: Package },
  { href: "/admin/ordenes", label: "Órdenes", icon: ShoppingCart },
  { href: "/admin/clientes", label: "Clientes", icon: Users },
  { href: "/admin/categorias", label: "Categorías", icon: FolderTree },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Admin</title>
    <style>
      /* Clases compartidas para páginas admin (Tailwind @apply) */
      .card {
        @apply bg-[#111] border border-[#1a1a1a] py-5 px-6;
      }
      .stat-value {
        @apply text-[28px] font-light mb-1;
      }
      .stat-label {
        @apply text-[10px] tracking-wide uppercase text-[#444];
      }
      .btn {
        @apply inline-flex items-center gap-1.5 py-2 px-4 text-[11px] tracking-wide uppercase cursor-pointer font-sans transition-all duration-150 border;
      }
      .btn-sm {
        @apply py-1.5 px-3 text-[10px];
      }
      .btn-primary {
        @apply bg-bone text-ink border-0;
      }
      .btn-primary:hover {
        @apply bg-rust text-bone;
      }
      .btn-ghost {
        @apply bg-transparent text-[#555] border border-[#222];
      }
      .btn-ghost:hover {
        @apply border-[#555] text-bone;
      }
      .btn-danger {
        @apply bg-rust/15 text-rust border border-rust/30;
      }
      .badge {
        @apply inline-block py-0.5 px-2 text-[10px] tracking-wide font-mono;
      }
      .badge-pendiente {
        @apply bg-amber-500/15 text-amber-600;
      }
      .badge-pagado {
        @apply bg-emerald-500/15 text-emerald-600;
      }
      .badge-enviado {
        @apply bg-blue-500/15 text-blue-400;
      }
      .badge-cancelado {
        @apply bg-rust/15 text-rust;
      }
      .badge-procesando {
        @apply bg-violet-500/15 text-violet-400;
      }
      .badge-entregado {
        @apply bg-emerald-500/15 text-emerald-600;
      }
      .input {
        @apply w-full bg-transparent border border-[#222] text-bone py-2 px-3 text-[13px] outline-none font-sans transition-colors focus:border-[#555];
      }
      table {
        @apply w-full border-collapse;
      }
      th {
        @apply text-left py-2.5 px-3 text-[10px] tracking-wide uppercase text-[#333] border-b border-[#1a1a1a] font-normal;
      }
      td {
        @apply py-3 px-3 border-b border-[#111] text-[#aaa] align-middle;
      }
      tr:hover td {
        @apply bg-[#0f0f0f];
      }
    </style>
  </head>
  <body class="min-h-screen flex text-[13px] bg-[#0d0d0d] text-bone font-sans">
    <!-- Sidebar -->
    <div
      class="w-[250px] shrink-0 border-r border-[#1a1a1a] py-6 flex flex-col sticky top-0 h-screen"
    >
      <h1
        class="text-base font-semibold tracking-[0.25em] uppercase text-white px-4 select-none"
      >
        T<span class="text-[#ff0000]">I</span>ENDA / ADMIN
      </h1>
      <nav class="flex-1 p-4 space-y-1">
        {
          nav.map(({ href, label, icon }) => {
            const Icon = icon;
            const isActive =
              href === "/admin"
                ? currentPath === "/admin"
                : currentPath === href || currentPath.startsWith(href + "/");
            return (
              <a
                href={href}
                class:list={[
                  "w-full flex items-center gap-3 px-4 py-3 text-sm transition-all rounded",
                  isActive
                    ? "text-red-500 bg-[#330000] border-l-2 border-[#ff0000]"
                    : "hover:text-bone hover:bg-[#111]",
                ]}
              >
                <Icon size={18} />
                {label}
              </a>
            );
          })
        }
      </nav>

      <div
        class="mt-auto pt-4 px-6 border-t border-[#1a1a1a] text-[11px] text-[#333]"
      >
        <div class="text-[#555] mb-2 select-none">{admin.nombre}</div>
        <a
          href="/api/admin/logout"
          class="text-base text-[#ff0000] underline underline-offset-[3px] hover:text-rust transition-colors flex gap-2 items-center"
        >
          <LogOut size={16} />

          Cerrar sesión
        </a>
      </div>
    </div>

    <!-- Main -->
    <div class="flex-1 overflow-y-auto">
      <div
        class="border-b border-[#1a1a1a] py-4 px-8 flex justify-between items-center sticky top-0 bg-[#0d0d0d] z-10"
      >
        <h1 class="text-lg font-medium tracking-wide capitalize">{title}</h1>
        <a
          href="/"
          target="_blank"
          class="text-[16px] text-emerald-500 hover:text-emerald-600 transition-colors"
        >
          Ver tienda →
        </a>
      </div>
      <div class="p-8">
        <slot />
      </div>
    </div>
  </body>
</html>
