---
const año = new Date().getFullYear();
---

<footer class="bg-[#0a0a0a]">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-2">
          <h1
            class="text-lg font-semibold tracking-[0.25em] uppercase text-white"
          >
            T<span class="text-[#ff0000]">I</span>ENDA
          </h1>
        </a>
        <p class="text-xs text-ash leading-relaxed max-w-xs select-none">
          Indumentaria de diseño. Prendas pensadas para durar.
        </p>
      </div>

      <div>
        <p class="label-sm mb-4 select-none">Catálogo</p>
        <ul class="space-y-2">
          {
            ["Remeras", "Pantalones", "Camperas", "Accesorios"].map((cat) => (
              <li>
                <a
                  href={`/productos?categoria=${cat.toLowerCase()}`}
                  class="text-[13px] text-ash hover:text-[#ff0000] transition-colors select-none"
                >
                  {cat}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="label-sm mb-4 select-none">Información</p>
        <ul class="space-y-2">
          {
            [
              { href: "/envios", label: "Envíos" },
              { href: "/devoluciones", label: "Devoluciones" },
              { href: "/talle", label: "Guía de talles" },
              { href: "/contacto", label: "Contacto" },
            ].map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="text-[13px] text-ash hover:text-[#ff0000] transition-colors select-none"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="label-sm mb-4 select-none">Seguinos</p>
        <ul class="space-y-2">
          <li>
            <a
              href="https://www.instagram.com/realyugan/"
              class="text-[13px] text-ash hover:text-[#ff0000] transition-colors select-none"
              target="_blank"
              rel="noopener noreferrer">Instagram</a
            >
          </li>
          <li>
            <a
              href="https://www.instagram.com/realyugan/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[13px] text-ash hover:text-[#ff0000] transition-colors select-none"
              >TikTok</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="border-t border-dust pt-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2"
    >
      <p class="text-[10px] text-ash select-none">
        © {año} TIENDA. Todos los derechos reservados.
      </p>
      <div class="flex gap-4">
        <a
          href="/privacidad"
          class="text-[10px] text-ash hover:text-[#ff0000] transition-colors select-none"
          >Privacidad</a
        >
        <a
          href="/terminos"
          class="text-[10px] text-ash hover:text-[#ff0000] transition-colors select-none"
          >Términos</a
        >
      </div>
    </div>
  </div>
</footer>
