---
const año = new Date().getFullYear();
---

<footer class="border-t border-dust mt-24 bg-bone">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
      <div class="col-span-2 md:col-span-1">
        <p class="text-xs font-mono tracking-[0.25em] uppercase mb-4">TIENDA</p>
        <p class="text-sm text-ash leading-relaxed max-w-xs">
          Indumentaria de diseño. Prendas pensadas para durar.
        </p>
      </div>

      <div>
        <p class="label-sm mb-4">Catálogo</p>
        <ul class="space-y-2">
          {
            ["Remeras", "Pantalones", "Camperas", "Accesorios"].map((cat) => (
              <li>
                <a
                  href={`/productos?categoria=${cat.toLowerCase()}`}
                  class="text-sm text-ash hover:text-ink transition-colors"
                >
                  {cat}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="label-sm mb-4">Información</p>
        <ul class="space-y-2">
          {
            [
              { href: "/envios", label: "Envíos" },
              { href: "/devoluciones", label: "Devoluciones" },
              { href: "/talle", label: "Guía de talles" },
              { href: "/contacto", label: "Contacto" },
            ].map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="text-sm text-ash hover:text-ink transition-colors"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="label-sm mb-4">Seguinos</p>
        <ul class="space-y-2">
          <li>
            <a
              href="https://www.instagram.com/realyugan/"
              class="text-sm text-ash hover:text-ink transition-colors"
              target="_blank"
              rel="noopener noreferrer">Instagram</a
            >
          </li>
          <li>
            <a
              href="https://www.instagram.com/realyugan/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-ash hover:text-ink transition-colors"
              >TikTok</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="border-t border-dust pt-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2"
    >
      <p class="label-sm">© {año} TIENDA. Todos los derechos reservados.</p>
      <div class="flex gap-4">
        <a href="/privacidad" class="label-sm hover:text-ink transition-colors"
          >Privacidad</a
        >
        <a href="/terminos" class="label-sm hover:text-ink transition-colors"
          >Términos</a
        >
      </div>
    </div>
  </div>
</footer>
