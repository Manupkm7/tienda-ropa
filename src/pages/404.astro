---
import Layout from "../components/layout/Layout.astro";
---

<Layout title="404 — Página no encontrada">
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col items-center justify-center min-h-[70vh] text-center gap-6"
  >
    <p class="font-mono text-xs tracking-[0.3em] uppercase text-ash">404</p>
    <h1 class="heading-xl text-ink/20">Página no<br />encontrada</h1>
    <p class="text-sm text-ash max-w-sm">
      La página que buscás no existe o fue movida.
    </p>
    <div class="flex gap-4">
      <a href="/" class="btn-primary">Ir al inicio</a>
      <a href="/productos" class="btn-outline">Ver catálogo</a>
    </div>
  </div>
</Layout>
