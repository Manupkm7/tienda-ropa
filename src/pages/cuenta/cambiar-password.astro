---
import CuentaLayout from "../../components/layout/CuentaLayout.astro";
import { getClienteFromCookies } from "../../lib/userAuth";

const cliente = await getClienteFromCookies(Astro.cookies);
if (!cliente) return Astro.redirect("/cuenta/login");

const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("success");
---

<CuentaLayout title="Cambiar contraseña">
  {
    success && (
      <div class="border border-green-200 bg-green-50 text-green-700 text-sm px-4 py-3 mb-6">
        ✓ Contraseña actualizada correctamente
      </div>
    )
  }
  {
    error && (
      <div class="border border-rust/30 bg-rust/5 text-rust text-sm px-4 py-3 mb-6">
        {decodeURIComponent(error)}
      </div>
    )
  }

  <form
    method="POST"
    action="/api/auth/cambiar-password"
    class="space-y-5 max-w-md"
  >
    <div>
      <label class="label-sm block mb-2">Contraseña actual</label>
      <input
        name="actual"
        type="password"
        class="input-field"
        required
        autocomplete="current-password"
      />
    </div>
    <div>
      <label class="label-sm block mb-2">Nueva contraseña</label>
      <input
        name="nueva"
        type="password"
        class="input-field"
        required
        autocomplete="new-password"
        minlength="8"
        placeholder="Mínimo 8 caracteres"
      />
    </div>
    <div>
      <label class="label-sm block mb-2">Confirmar nueva contraseña</label>
      <input
        name="confirmar"
        type="password"
        class="input-field"
        required
        autocomplete="new-password"
      />
    </div>
    <div class="flex gap-3 pt-2">
      <button type="submit" class="btn-primary">Actualizar contraseña</button>
      <a href="/cuenta/perfil" class="btn-outline">Cancelar</a>
    </div>
  </form>
</CuentaLayout>
