---
import Layout from '../../components/layout/Layout.astro';

const error = Astro.url.searchParams.get('error');
const token = Astro.url.searchParams.get('token') ?? '';

if (!token) {
  return Astro.redirect(
    '/cuenta/recuperar?error=' +
      encodeURIComponent('El enlace para restablecer la contraseña no es válido o ya fue usado.'),
  );
}
---

<Layout title="Restablecer contraseña">
  <div class="max-w-md mx-auto px-4 py-20">

    <div class="mb-12 text-center select-none">
      <p class="text-center text-sm tracking-[0.3em] text-ash">Mi cuenta</p>
      <h1 class="text-3xl font-light text-[#ff0000]">Restablecer contraseña</h1>
    </div>

    {error && (
      <div class="border border-rust/30 bg-rust/5 text-rust text-sm px-4 py-3 mb-6">
        {decodeURIComponent(error)}
      </div>
    )}

    <form method="POST" action="/api/auth/restablecer-password" class="space-y-5">
      <input type="hidden" name="token" value={token} />

      <div>
        <label class="label-sm block mb-2">Nueva contraseña</label>
        <input
          name="nueva"
          type="password"
          class="input-field"
          required
          minlength={8}
          autocomplete="new-password"
        />
      </div>

      <div>
        <label class="label-sm block mb-2">Confirmar contraseña</label>
        <input
          name="confirmar"
          type="password"
          class="input-field"
          required
          minlength={8}
          autocomplete="new-password"
        />
      </div>

      <button type="submit" class="btn-primary w-full">
        Guardar nueva contraseña
      </button>
    </form>

  </div>
</Layout>

