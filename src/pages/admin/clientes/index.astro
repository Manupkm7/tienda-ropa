---
import { Mail, MoreHorizontal, Phone, Search } from "lucide-react";
import AdminLayout from "../../../components/admin/AdminLayout.astro";
import { db } from "../../../lib/db";
import { clientes, ordenes } from "../../../lib/db/schema";
import { and, ilike, or, sql } from "drizzle-orm";

const params = Astro.url.searchParams;
const q = params.get("q") ?? "";

const where = q
  ? or(
      ilike(clientes.nombre, `%${q}%`),
      ilike(clientes.apellido, `%${q}%`),
      ilike(clientes.email, `%${q}%`),
    )
  : undefined;

const todos = await db.query.clientes.findMany({
  where,
  orderBy: (c, { desc }) => [desc(c.creadoEn)],
  with: { ordenes: true },
});

const fmt = (n: number) =>
  new Intl.NumberFormat("es-AR", {
    style: "currency",
    currency: "ARS",
    maximumFractionDigits: 0,
  }).format(n);

const fmtFecha = (d: Date) =>
  new Intl.DateTimeFormat("es-AR", {
    day: "2-digit",
    month: "2-digit",
    year: "2-digit",
  }).format(d);

const clientesConStats = todos.map((c) => {
  const ordenesCliente = (c.ordenes ?? []).slice().sort((a, b) => {
    return b.creadoEn.getTime() - a.creadoEn.getTime();
  });

  const cantidadOrdenes = ordenesCliente.length;
  const totalGastado = ordenesCliente.reduce(
    (acc, o) => acc + parseFloat(String(o.total)),
    0,
  );
  const ultimaOrden = ordenesCliente[0] ?? null;

  return {
    ...c,
    cantidadOrdenes,
    totalGastado,
    ultimaOrden,
    ordenesOrdenadas: ordenesCliente,
  };
});
---

<AdminLayout title="Clientes">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-4">
      <p class="text-sm text-[#666666]">
        {clientesConStats.length} clientes
      </p>
      <form class="relative" method="GET" action="/admin/clientes">
        <Search
          size={16}
          className="absolute right-3 top-1/2 -translate-y-1/2 text-[#666666]"
        />
        <input
          type="text"
          name="q"
          value={q}
          placeholder="Buscar por nombre o email..."
          class="input-field pr-8"
        />
      </form>
    </div>
  </div>

  <div class="p-6 relative rounded border border-gray-500 bg-[#050505]">
    <table class="w-full">
      <thead>
        <tr class="border-b">
          <th class="text-left text-xs font-medium px-4 py-3">Cliente</th>
          <th class="text-left text-xs font-medium px-4 py-3">Contacto</th>
          <th class="text-left text-xs font-medium px-4 py-3">
            Cant. órdenes
          </th>
          <th class="text-left text-xs font-medium px-4 py-3">
            Total gastado
          </th>
          <th class="text-left text-xs font-medium px-4 py-3">
            Última orden
          </th>
          <th class="text-left text-xs font-medium px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        {
          clientesConStats.length === 0 && (
            <tr>
              <td
                colspan="6"
                class="px-4 py-8 text-center text-sm text-[#444444]"
              >
                No se encontraron clientes.
              </td>
            </tr>
          )
        }
        {
          clientesConStats.map((cli) => (
            <tr class="border-b border-gray-500 transition-colors">
              <td class="px-4 py-4 flex items-center gap-1">
                <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-medium bg-[#330000] text-[#ff0000]">
                  {`${cli.nombre} ${cli.apellido}`
                    .split(" ")
                    .map((n) => n[0])
                    .join("")}
                </div>
                <div class="flex flex-col gap-0.5">
                  <span class="text-base text-white">
                    {cli.nombre} {cli.apellido}
                  </span>
                  <span class="text-xs text-[#666666]">ID #{cli.id}</span>
                </div>
              </td>
              <td class="px-4 py-4">
                <div class="flex flex-col gap-1">
                  <span class="flex items-center gap-2 text-sm text-[#888888]">
                    <Mail color="#ff0000" size={16} />
                    {cli.email}
                  </span>
                  {cli.telefono && (
                    <span class="flex items-center gap-2 text-xs text-[#888888]">
                      <Phone color="#ff0000" size={16} />
                      {cli.telefono}
                    </span>
                  )}
                </div>
              </td>
              <td class="px-4 py-4">{cli.cantidadOrdenes}</td>
              <td class="px-4 py-4 text-sm text-[#ff0000]">
                {cli.cantidadOrdenes > 0 ? fmt(cli.totalGastado) : "—"}
              </td>
              <td class="px-4 py-4 text-sm">
                {cli.ultimaOrden ? fmtFecha(cli.ultimaOrden.creadoEn) : "—"}
              </td>
              <td class="px-4 py-4 text-right">
                <div class="relative inline-block text-left">
                  <button
                    type="button"
                    class="p-1.5 rounded hover:bg-[#1a1a1a] transition-colors"
                    data-menu-trigger={`cliente-${cli.id}`}
                  >
                    <MoreHorizontal size={18} />
                  </button>
                  <div
                    class="hidden absolute right-0 mt-2 w-44 rounded border border-[#222222] bg-[#050505] shadow-lg z-20"
                    data-menu={`cliente-${cli.id}`}
                  >
                    <button
                      type="button"
                      class="w-full text-left px-3 py-2 text-sm hover:bg-[#111111]"
                      data-open-sidebar={`cliente-${cli.id}`}
                    >
                      Ver ficha completa
                    </button>
                    <button
                      type="button"
                      class="w-full text-left px-3 py-2 text-sm hover:bg-[#111111]"
                      data-copy-email={cli.email}
                    >
                      Copiar email
                    </button>
                  </div>
                </div>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {
    clientesConStats.map((cli) => (
      <template id={`cliente-tpl-${cli.id}`}>
        <div class="flex flex-col h-full rounded p-3 bg-[#0a0a0a] border border-[#1a1a1a]">
          <div class="flex items-center gap-2 border-b border-[#1a1a1a] py-2">
            <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-medium bg-[#330000] text-[#ff0000]">
              {`${cli.nombre} ${cli.apellido}`
                .split(" ")
                .map((n) => n[0])
                .join("")}
            </div>
            <div class="flex flex-col gap-0.5">
              <h2 class="text-lg font-medium text-white">
                {cli.nombre} {cli.apellido}
              </h2>
              <p class="text-xs text-[#666666]">ID #{cli.id}</p>
            </div>
          </div>

          <div class="space-y-4 overflow-y-auto mt-2">
            <section class="border-b border-[#1a1a1a] pb-3">
              <h3 class="text-base tracking-[0.2em] mb-3 text-[#666666]">
                CONTACTO
              </h3>
              <div class="space-y-1.5 text-sm">
                <div>
                  <span class="flex items-center gap-2 text-sm text-[#888888]">
                    <Mail color="#ff0000" size={16} />
                    {cli.email}
                  </span>
                </div>
                {cli.telefono && (
                  <div>
                    <span class="flex items-center gap-2 text-xs text-[#888888]">
                      <Phone color="#ff0000" size={16} />
                      {cli.telefono}
                    </span>
                  </div>
                )}
                {cli.dni && (
                  <div>
                    <span class="text-[#666666] text-xs">DNI</span>
                    <div>{cli.dni}</div>
                  </div>
                )}
              </div>
            </section>

            {cli.direccionEnvio && (
              <section class="border-b border-[#1a1a1a] pb-3">
                <h3 class="text-base tracking-[0.2em] mb-3 text-[#666666]">
                  DIRECCIÓN PRINCIPAL
                </h3>
                <div class="text-sm flex flex-col gap-1">
                  <span class="text-[#888888]">
                    {cli.direccionEnvio.calle} {cli.direccionEnvio.numero}
                  </span>
                  <span class="text-[#888888]">
                    {cli.direccionEnvio.ciudad}, {cli.direccionEnvio.provincia}
                  </span>
                  <span class="text-[#888888]">
                    CP {cli.direccionEnvio.codigoPostal}
                  </span>
                  <span class="text-[#888888]">
                    {cli.direccionEnvio.pais}
                  </span>
                </div>
              </section>
            )}

            <section>
              <h3 class="text-base tracking-[0.2em] mb-3 text-[#666666]">
                HISTORIAL DE ÓRDENES
              </h3>
              {cli.ordenesOrdenadas.length === 0 ? (
                <p class="text-xs text-[#444444]">Sin órdenes todavía.</p>
              ) : (
                <div class="space-y-2">
                  {cli.ordenesOrdenadas.map((o) => (
                    <div class="flex items-center justify-between text-xs border border-[#1a1a1a] rounded px-3 py-2">
                      <div>
                        <div class="text-sm">
                          #{String(o.numero).padStart(4, "0")}
                        </div>
                        <div class="text-[11px] text-[#666666]">
                          {fmtFecha(o.creadoEn)}
                        </div>
                      </div>
                      <div class="text-right">
                        <div class="text-sm text-[#ff0000]">
                          {fmt(parseFloat(String(o.total)))}
                        </div>
                        <a
                          href={`/admin/ordenes/${o.id}`}
                          class="text-[11px] text-[#888888] hover:text-[#ff0000]"
                        >
                          Ver orden →
                        </a>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </section>
          </div>
        </div>
      </template>
    ))
  }

  <div
    id="cliente-sidebar-overlay"
    class="hidden fixed inset-0 z-30 bg-black/40"
  >
    <div class="absolute inset-0" data-close-sidebar></div>
    <aside
      class="absolute right-0 top-0 h-full w-full max-w-md bg-[#050505] border-l border-[#1a1a1a] p-6 flex flex-col"
      id="cliente-sidebar"
    >
    </aside>
  </div>
</AdminLayout>

<script>
  const menus = document.querySelectorAll("[data-menu-trigger]");
  const sidebarOverlay = document.getElementById("cliente-sidebar-overlay");
  const sidebar = document.getElementById("cliente-sidebar");

  menus.forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const key = btn.getAttribute("data-menu-trigger");
      if (!key) return;
      const menu = document.querySelector(`[data-menu="${key}"]`);
      if (!menu) return;

      const isOpen = !menu.classList.contains("hidden");
      document
        .querySelectorAll("[data-menu]")
        .forEach((m) => m.classList.add("hidden"));
      if (!isOpen) {
        menu.classList.remove("hidden");
      }
    });
  });

  document.addEventListener("click", (e) => {
    const target = e.target;
    if (!(target instanceof HTMLElement)) return;

    if (
      !target.closest("[data-menu-trigger]") &&
      !target.closest("[data-menu]")
    ) {
      document
        .querySelectorAll("[data-menu]")
        .forEach((m) => m.classList.add("hidden"));
    }

    const openSidebarKey = target.getAttribute("data-open-sidebar");
    if (openSidebarKey && sidebar && sidebarOverlay) {
      const tpl = document.getElementById(
        `cliente-tpl-${openSidebarKey.replace("cliente-", "")}`,
      );
      if (tpl instanceof HTMLTemplateElement) {
        sidebar.innerHTML = "";
        sidebar.appendChild(tpl.content.cloneNode(true));
        sidebarOverlay.classList.remove("hidden");
      }
      document
        .querySelectorAll("[data-menu]")
        .forEach((m) => m.classList.add("hidden"));
    }

    if (target.hasAttribute("data-close-sidebar") && sidebarOverlay) {
      sidebarOverlay.classList.add("hidden");
    }

    const emailToCopy = target.getAttribute("data-copy-email");
    if (emailToCopy) {
      navigator.clipboard?.writeText(emailToCopy).catch(() => {});
      document
        .querySelectorAll("[data-menu]")
        .forEach((m) => m.classList.add("hidden"));
    }
  });
</script>
