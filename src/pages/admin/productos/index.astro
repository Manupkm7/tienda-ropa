---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { db } from '../../../lib/db';
import { productos, variantes } from '../../../lib/db/schema';
import { eq, desc, sql } from 'drizzle-orm';

const todos = await db.query.productos.findMany({
  orderBy: [desc(productos.creadoEn)],
  with: {
    categoria: true,
    variantes: { where: eq(variantes.activa, true) },
  },
});

const fmt = (n: number) =>
  new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(n);

const productosConStock = todos.map(prod => {
  const stockTotal = prod.variantes.reduce((s, v) => s + v.stock, 0);
  const stockBajo = stockTotal > 0 && stockTotal <= 5;
  return { ...prod, stockTotal, stockBajo };
});
---

<AdminLayout title="Productos">

  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
    <div style="font-size:12px; color:#555;">{todos.length} productos</div>
    <a href="/admin/productos/nuevo" class="btn btn-primary">+ Nuevo producto</a>
  </div>

  <div class="card">
    <table>
      <thead>
        <tr>
          <th>Producto</th>
          <th>Categoría</th>
          <th>Precio</th>
          <th>Stock total</th>
          <th>Estado</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {productosConStock.map(prod => {
          return (
            <tr>
              <td>
                <div style="display:flex; align-items:center; gap:10px;">
                  <div style="width:36px; height:44px; background:#1a1a1a; flex-shrink:0; overflow:hidden;">
                    <img src={prod.imagenes?.[0] || '/images/placeholder.jpg'} alt={prod.nombre}
                         style="width:100%; height:100%; object-fit:cover;" />
                  </div>
                  <div>
                    <div style="color:#F5F2ED; font-size:13px;">{prod.nombre}</div>
                    <div style="font-size:10px; color:#333; font-family:monospace;">{prod.slug}</div>
                  </div>
                </div>
              </td>
              <td style="font-size:12px;">{prod.categoria?.nombre ?? '—'}</td>
              <td style="font-family:monospace; color:#F5F2ED; white-space:nowrap;">
                {fmt(parseFloat(prod.precio))}
                {prod.precioOriginal && (
                  <span style="font-size:11px; color:#333; text-decoration:line-through; margin-left:4px;">
                    {fmt(parseFloat(prod.precioOriginal))}
                  </span>
                )}
              </td>
              <td>
                <span style={`font-family:monospace; font-size:13px; color:${prod.stockTotal === 0 ? '#C4522A' : prod.stockBajo ? '#b49a00' : '#F5F2ED'};`}>
                  {prod.stockTotal}
                </span>
                <span style="font-size:10px; color:#333; margin-left:4px;">
                  ({prod.variantes.length} vars)
                </span>
              </td>
              <td>
                {prod.activo
                  ? <span class="badge" style="background:rgba(0,160,80,0.1); color:#00a050;">activo</span>
                  : <span class="badge" style="background:rgba(100,100,100,0.1); color:#555;">inactivo</span>
                }
                {prod.destacado && (
                  <span class="badge" style="background:rgba(196,82,42,0.1); color:#C4522A; margin-left:4px;">destacado</span>
                )}
              </td>
              <td>
                <div style="display:flex; gap:6px;">
                  <a href={`/admin/productos/${prod.id}`} class="btn btn-ghost btn-sm">Editar</a>
                  <a href={`/productos/${prod.slug}`} target="_blank" class="btn btn-ghost btn-sm">Ver →</a>
                </div>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

</AdminLayout>
