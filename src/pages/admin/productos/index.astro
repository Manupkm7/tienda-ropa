---
import { ArrowRight, Pencil, Plus, Search } from "lucide-react";
import AdminLayout from "../../../components/admin/AdminLayout.astro";
import { db } from "../../../lib/db";
import { productos, variantes } from "../../../lib/db/schema";
import { eq, desc, sql } from "drizzle-orm";

const todos = await db.query.productos.findMany({
  orderBy: [desc(productos.creadoEn)],
  with: {
    categoria: true,
    variantes: { where: eq(variantes.activa, true) },
  },
});

const fmt = (n: number) =>
  new Intl.NumberFormat("es-AR", {
    style: "currency",
    currency: "ARS",
    maximumFractionDigits: 0,
  }).format(n);

const productosConStock = todos.map((prod) => {
  const stockTotal = prod.variantes.reduce((s, v) => s + v.stock, 0);
  const stockBajo = stockTotal > 0 && stockTotal <= 5;
  return { ...prod, stockTotal, stockBajo };
});
---

<AdminLayout title="Productos">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-4">
      <p class="text-sm text-[#666666]">
        {todos.length} productos
      </p>
      <div class="relative">
        <Search
          size={16}
          className="absolute right-3 top-1/2 -translate-y-1/2 text-[#666666]"
        />
        <input
          type="text"
          placeholder="Buscar productos..."
          class="input-field"
        />
      </div>
    </div>

    <a
      href="/admin/productos/nuevo"
      class="btn btn-primary bg-[#ff0000] flex items-center gap-2"
    >
      <Plus size={16} />
      Nuevo producto
    </a>
  </div>

  <div class="rounded p-6 bg-[#0a0a0a] border border-[#1a1a1a]">
    <table class="w-full">
      <thead>
        <tr class="border-b">
          <th class="text-left text-xs font-medium px-4 py-3">Producto</th>
          <th class="text-left text-xs font-medium px-4 py-3">Categoría</th>
          <th class="text-left text-xs font-medium px-4 py-3">Precio</th>
          <th class="text-left text-xs font-medium px-4 py-3">Stock total</th>
          <th class="text-left text-xs font-medium px-4 py-3">Estado</th>
          <th class="text-left text-xs font-medium px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        {
          productosConStock.map((prod) => {
            return (
              <tr class="border-b border-gray-500 transition-colors">
                <td class="px-4 py-4">
                  <div class="flex items-center gap-2.5">
                    <div class="w-[36px] h-[44px] bg-[#1a1a1a] shrink-0; overflow-hidden">
                      <img
                        src={prod.imagenes?.[0] || "/images/placeholder.jpg"}
                        alt={prod.nombre}
                        class="w-full h-full object-cover"
                      />
                    </div>
                    <div>
                      <p class="text-base font-medium">{prod.nombre}</p>
                      <p class="text-sm text-[#666666]">{prod.slug}</p>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-4 text-sm">
                  {prod.categoria?.nombre ?? "—"}
                </td>
                <td class="px-4 py-4 text-base flex flex-col justify-center gap-0.5 text-[#ff0000]">
                  {fmt(parseFloat(prod.precio))}

                  {prod.precioOriginal ? (
                    <span class="text-sm leading-0 text-[#666666] line-through">
                      {fmt(parseFloat(prod.precioOriginal))}
                    </span>
                  ) : null}
                </td>
                <td class="px-4 py-4">
                  <span
                    class={`text-sm ${prod.stockTotal === 0 ? "text-[#C4522A]" : prod.stockBajo ? "text-[#b49a00]" : "text-[#F5F2ED]"};`}
                  >
                    {prod.stockTotal}
                  </span>
                  <span class="text-sx text-[#333] ml-2">
                    ({prod.variantes.length} variantes)
                  </span>
                </td>
                <td class="px-4 py-4">
                  <div class="flex items-center gap-1.5">
                    {prod.activo ? (
                      <span class="text-xs px-2 py-1 rounded bg-emerald-500 text-white">
                        activo
                      </span>
                    ) : (
                      <span class="text-xs px-2 py-1 rounded bg-rust text-white">
                        inactivo
                      </span>
                    )}
                    {prod.destacado && (
                      <span class="text-xs px-2 py-1 rounded bg-[#ff0000] text-white">
                        destacado
                      </span>
                    )}
                  </div>
                </td>
                <td class="px-4 py-4">
                  <div class="flex items-center gap-3">
                    <a
                      href={`/admin/productos/${prod.id}`}
                      class="text-emerald-500 transition-colors hover:text-emerald-800 flex items-center gap-0.5 border p-2 rounded border-[#888888]"
                    >
                      Editar <Pencil size={14} />
                    </a>
                    <a
                      href={`/productos/${prod.slug}`}
                      target="_blank"
                      class="text-[#ff0000] transition-colors hover:text-rust flex items-center gap-0.5 border p-2 rounded border-[#888888]"
                    >
                      Ver <ArrowRight size={14} />
                    </a>
                  </div>
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
</AdminLayout>
