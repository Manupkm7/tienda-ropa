---
import {
  AlertTriangle,
  ArrowUpRight,
  DollarSign,
  Package,
  ShoppingCart,
  TrendingUp,
  Users,
} from "lucide-react";
import AdminLayout from "../../components/admin/AdminLayout.astro";
import { db } from "../../lib/db";
import { ordenes, productos, clientes, variantes } from "../../lib/db/schema";
import { eq, sql, gte, count } from "drizzle-orm";

// Stats
const [
  totalOrdenes,
  ordenesPagadas,
  totalProductos,
  totalClientes,
  ventasHoy,
  stockBajo,
  ordenesRecientes,
] = await Promise.all([
  db.select({ c: count() }).from(ordenes),
  db
    .select({ total: sql<number>`SUM(total::numeric)` })
    .from(ordenes)
    .where(eq(ordenes.estado, "pagado")),
  db.select({ c: count() }).from(productos).where(eq(productos.activo, true)),
  db.select({ c: count() }).from(clientes),
  db
    .select({ total: sql<number>`COALESCE(SUM(total::numeric), 0)` })
    .from(ordenes)
    .where(sql`DATE(creado_en) = CURRENT_DATE AND estado = 'pagado'`),
  db
    .select({ c: count() })
    .from(variantes)
    .where(sql`stock > 0 AND stock <= 3 AND activa = true`),
  db.query.ordenes.findMany({
    orderBy: (o, { desc }) => [desc(o.creadoEn)],
    limit: 8,
    with: { cliente: true },
  }),
]);

const fmt = (n: number) =>
  new Intl.NumberFormat("es-AR", {
    style: "currency",
    currency: "ARS",
    maximumFractionDigits: 0,
  }).format(n);

const fmtFecha = (d: Date) =>
  new Intl.DateTimeFormat("es-AR", {
    day: "2-digit",
    month: "2-digit",
    year: "2-digit",
  }).format(d);

const getStatusColor = (status: string) => {
  switch (status) {
    case "activo":
      return "#047857";
    case "pagado":
      return "#047857";
    case "entregado":
      return "#047857";
    case "visible":
      return "#047857";
    case "pendiente":
      return "#b45309";
    case "procesando":
      return "#b45309";
    case "cancelado":
      return "#FF0000";
    case "inactivo":
      return "#FF0000";
    case "oculto":
      return "#FF0000";
    default:
      return "#7e22ce";
  }
};
---

<AdminLayout title="Dashboard">
  <!-- Stats -->
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
    <div class="p-4 rounded border border-gray-500 bg-[#050505]">
      <div class="flex items-center justify-between mb-2">
        <DollarSign size={18} color="#047857" />
        {
          ordenesPagadas[0]?.total >= 100 && (
            <span class="text-xs flex items-center">
              <ArrowUpRight size={14} className="text-emerald-500" />
            </span>
          )
        }
      </div>
      <p class="text-2xl font-medium mb-1 text-emerald-500">
        {fmt(parseFloat(String(ordenesPagadas[0]?.total ?? 0)))}
      </p>
      <p class="text-base text-ash select-none">Ingresos totales</p>
    </div>
    <div class="p-4 rounded border border-gray-500 bg-[#050505]">
      <div class="flex items-center justify-between mb-2">
        <TrendingUp size={18} color="#047857" />
        {
          ventasHoy[0]?.total >= 100 && (
            <span class="text-xs flex items-center">
              <ArrowUpRight size={14} className="text-emerald-500" />
            </span>
          )
        }
      </div>
      <p class="text-2xl font-medium mb-1 text-emerald-500">
        {fmt(parseFloat(String(ventasHoy[0]?.total ?? 0)))}
      </p>
      <p class="text-base text-ash select-none">Ventas hoy</p>
    </div>
    <div class="p-4 rounded border border-gray-500 bg-[#050505]">
      <div class="flex items-center justify-between mb-2">
        <ShoppingCart size={18} color="#047857" />
        {
          totalOrdenes[0]?.c >= 50 && (
            <span class="text-xs flex items-center">
              <ArrowUpRight size={14} className="text-emerald-500" />
            </span>
          )
        }
      </div>
      <p class="text-2xl font-medium mb-1 text-emerald-500">
        {totalOrdenes[0].c}
      </p>
      <p class="text-base text-ash select-none">Total órdenes</p>
    </div>
    <div class="p-4 rounded border border-gray-500 bg-[#050505]">
      <div class="flex items-center justify-between mb-2">
        <Package size={18} color="#047857" />
        {
          totalProductos[0]?.c >= 50 && (
            <span class="text-xs flex items-center">
              <ArrowUpRight size={18} className="text-emerald-500" />
            </span>
          )
        }
      </div>
      <p class="text-2xl font-medium mb-1 text-emerald-500">
        {totalProductos[0].c}
      </p>
      <div class="text-base text-ash select-none">Productos activos</div>
    </div>
    <div class="p-4 rounded border border-gray-500 bg-[#050505]">
      <div class="flex items-center justify-between mb-2">
        <Users size={18} color="#047857" />
        {
          totalClientes[0]?.c >= 25 && (
            <span class="text-xs flex items-center">
              <ArrowUpRight size={18} className="text-emerald-500" />
            </span>
          )
        }
      </div>
      <p class="text-2xl font-medium mb-1 text-emerald-500">
        {totalClientes[0].c}
      </p>
      <div class="text-base text-ash select-none">Clientes</div>
    </div>
    {
      stockBajo[0].c > 0 && (
        <div
          class={`p-4 rounded border transition-colors bg-[#050505] ${stockBajo[0].c > 0 ? "border-[#ff0000]" : ""}`}
        >
          <div class="flex items-center justify-between mb-2">
            <AlertTriangle size={18} color="#ff0000" />
            {totalProductos[0]?.c >= 50 && (
              <span class="text-xs flex items-center">
                <ArrowUpRight size={18} className="text-emerald-500" />
              </span>
            )}
          </div>
          <p class="text-2xl font-medium mb-1 text-[#ff0000]">
            {stockBajo[0].c}
          </p>
          <p class="text-base text-[#ff0000] select-none">Stock bajo (&le;3)</p>
        </div>
      )
    }
  </div>
  <div class="rounded border border-gray-500 bg-[#050505]">
    <div class="flex items-center justify-between p-4 border-b border-gray-500">
      <h3 class="text-xs tracking-[0.2em]">ÓRDENES RECIENTES</h3>
      <a
        href="/admin/ordenes"
        class="text-xs transition-colors hover:opacity-70 text-[#ff0000] hover:text-rust"
      >
        Ver todas
      </a>
    </div>
    <table class="w-full">
      <thead>
        <tr class="border-b">
          <th class="text-left text-xs font-medium px-4 py-3">Número</th>
          <th class="text-left text-xs font-medium px-4 py-3">Cliente</th>
          <th class="text-left text-xs font-medium px-4 py-3">Estado</th>
          <th class="text-left text-xs font-medium px-4 py-3">Total</th>
          <th class="text-left text-xs font-medium px-4 py-3">Fecha</th>
          <th class="text-left text-xs font-medium px-4 py-3"></th>

        </tr>
      </thead>
      <tbody>
        {
          ordenesRecientes.map((order) => (
            <tr class="border-b border-gray-500 transition-colors">
              <td class="px-4 py-4">
                <span class="text-sm font-mono">#{order.numero}</span>
              </td>
              <td class="px-4 py-4">
                <p class="text-sm">
                  {order.cliente?.nombre} {order.cliente?.apellido}
                </p>
                <p class="text-xs">{order.cliente?.email}</p>
              </td>
              <td class="px-4 py-4">
                <span
                  class="text-xs px-2 py-1 rounded"
                  style={{
                    backgroundColor: `${getStatusColor(order.estado)}20`,
                    color: getStatusColor(order.estado),
                  }}
                >
                  {order.estado}
                </span>
              </td>
              <td class="px-4 py-4 text-sm font-mono">
                $ {order.total.toLocaleString()}
              </td>
              <td class="px-4 py-4 text-sm">{fmtFecha(order.creadoEn)}</td>
              <td class="px-4 py-4">
                <a
                  href={`/admin/ordenes/${order.id}`}
                  rel="noreferrer"
                  target="_blank"
                  class="text-xs flex items-center gap-1 transition-colors hover:opacity-70 text-[#ff0000] hover:text-rust"
                >
                  Ver <span>→</span>
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</AdminLayout>
