---
import { ArrowLeft, Copy, Mail, Phone, Truck } from "lucide-react";
import AdminLayout from "../../../components/admin/AdminLayout.astro";
import { db } from "../../../lib/db";
import { ordenes } from "../../../lib/db/schema";
import { eq } from "drizzle-orm";

const { id } = Astro.params;
if (!id) return Astro.redirect("/admin/ordenes");

const orden = await db.query.ordenes.findFirst({
  where: eq(ordenes.id, id),
  with: { cliente: true },
});

if (!orden) return Astro.redirect("/admin/ordenes");

const fmt = (n: number) =>
  new Intl.NumberFormat("es-AR", {
    style: "currency",
    currency: "ARS",
    maximumFractionDigits: 0,
  }).format(n);

const ESTADOS_SIGUIENTES: Record<string, string[]> = {
  pendiente: ["pagado", "cancelado"],
  pagado: ["procesando", "cancelado"],
  procesando: ["empaquetado", "cancelado"],
  empaquetado: ["enviado"],
  enviado: ["entregado"],
  entregado: [],
  cancelado: ["reembolsado"],
  reembolsado: [],
};

const getStatusColor = (status: string) => {
  switch (status) {
    case "activo":
      return "#047857";
    case "pagado":
      return "#047857";
    case "entregado":
      return "#047857";
    case "visible":
      return "#047857";
    case "pendiente":
      return "#b45309";
    case "procesando":
      return "#b45309";
    case "cancelado":
      return "#FF0000";
    case "inactivo":
      return "#FF0000";
    case "oculto":
      return "#FF0000";
    default:
      return "#7e22ce";
  }
};

const siguientes = ESTADOS_SIGUIENTES[orden.estado] ?? [];
---

<AdminLayout title={`Orden #${String(orden.numero).padStart(4, "0")}`}>
  <div
    class="flex justify-between items-center mb-6"
    id="orden-header"
    data-orden-id={orden.id}
  >
    <a
      href="/admin/ordenes"
      class="text-sm mb-6 flex items-center gap-2 transition-colors hover:opacity-70 text-[#ff0000] hover:text-rust"
    >
      <ArrowLeft />
      Volver
    </a>
    <div class="flex gap-2 items-center" id="estado-buttons">
      {
        siguientes.map((sig) => {
          const esCanceladoDeshabilitado =
            orden.estado === "pagado" && sig === "cancelado";
          return (
            <button
              type="button"
              data-estado={sig}
              disabled={esCanceladoDeshabilitado}
              class={`btn p-2 rounded text-[14px] ${
                sig === "cancelado" ? "bg-[#ff0000]" : "bg-emerald-500"
              } ${esCanceladoDeshabilitado ? "opacity-40 cursor-not-allowed" : ""}`}
            >
              {sig}
            </button>
          );
        })
      }
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Izquierda -->
    <div class="flex flex-col gap-4 col-span-2">
      <!-- Items -->
      <div class="rounded p-6 bg-[#0a0a0a] border border-[#1a1a1a]">
        <h3 class="text-xs tracking-[0.2em] mb-6 text-[#666666]">
          Items del pedido
        </h3>
        <div class="divide-y">
          {
            (orden.items ?? []).map((item) => (
              <div class="flex items-center justify-between gap-4 p-4">
                <div class="flex gap-2 items-center">
                  <div class="w-[56px] h-[70px] bg-[#1a1a1a] shrink:0 overflow-hidden">
                    <img
                      src={item.imagen || "/images/placeholder.jpg"}
                      alt={item.nombre}
                      class="w-full h-full object-cover"
                    />
                  </div>
                  <div class="flex flex-col">
                    <span class="text-base font-medium text-white">
                      {item.nombre}
                    </span>
                    {(item.color || item.talla) && (
                      <span class="text-sm text-[#666666] mt-1.5">
                        {[item.color, item.talla].filter(Boolean).join(" / ")}
                      </span>
                    )}
                    {item.sku && (
                      <span class="text-sm text-[#555]">SKU: {item.sku}</span>
                    )}
                  </div>
                </div>
                <div class="flex flex-col items-end">
                  <div class="text-base text-[#ff0000]">
                    {fmt(item.precio * item.cantidad)}
                  </div>
                  <div class="text-sm text-[#F5F2ED]">
                    ×{item.cantidad} × {fmt(item.precio)}
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <div class="py-4 border-t space-y-2 w-full flex flex-col">
          <div class="flex items-center justify-between mb-1.5 px-4">
            <span>Subtotal</span>
            <span class="text-sm">
              {fmt(parseFloat(orden.subtotal))}
            </span>
          </div>
          {
            parseFloat(orden.costoEnvio ?? "0") > 0 && (
              <div class="flex justify-between text-sm text-[#555] mb-2.5 px-4">
                <>
                  <span>Envío</span>
                  <span class="text-sm">
                    {fmt(parseFloat(orden.costoEnvio!))}
                  </span>
                </>
              </div>
            )
          }
          <div
            class="flex justify-between font-semibold mt-2 pt-2 border-t px-4"
          >
            <span class="text-lg">Total</span>
            <span class="text-lg text-[#ff0000]">
              {fmt(parseFloat(orden.total))}
            </span>
          </div>
        </div>
      </div>

      <!-- Notas -->
      {
        (orden.notasCliente || orden.notasAdmin) && (
          <div class="rounded p-6 bg-[#0a0a0a] border border-[#1a1a1a]">
            <h3 class="text-xs tracking-[0.2em] mb-6 text-[#666666]">Notas</h3>
            {orden.notasCliente && (
              <div class="margin-bottom:12px;">
                <div class="text-[10px] color:#333; margin-bottom:4px; text-transform:uppercase; letter-spacing:0.1em;">
                  Del cliente
                </div>
                <p class="text-[13px] color:#aaa;">{orden.notasCliente}</p>
              </div>
            )}
            {orden.notasAdmin && (
              <div>
                <div class="text-[10px] color:#333; margin-bottom:4px; text-transform:uppercase; letter-spacing:0.1em;">
                  Admin
                </div>
                <p class="text-[13px] color:#aaa;">{orden.notasAdmin}</p>
              </div>
            )}
          </div>
        )
      }

      <!-- Nota admin form -->
      <div class="rounded p-6 bg-[#0a0a0a] border border-[#1a1a1a]" id="nota-admin">
        <h3 class="text-xs tracking-[0.2em] mb-8 text-[#666666]">
          Agregar nota interna
        </h3>
        <form class="flex gap-2" id="nota-form">
          <textarea
            name="nota"
            class="input-field resize-y flex-1"
            rows="5"
            placeholder="Nota interna..."></textarea>
          <button type="submit" class="btn btn-primary border-[#ff0000]">
            Guardar
          </button>
        </form>
      </div>
    </div>

    <!-- Derecha -->
    <div class="flex flex-col gap-4">
      <!-- Estado -->
      <div class="rounded p-6 bg-[#0a0a0a] border border-[#1a1a1a]">
        <h3 class="text-xs tracking-[0.2em] mb-6 text-[#666666]">Estado</h3>
        <span
          class={`badge badge-${orden.estado} text-base capitalize p-2`}
          style={{
            backgroundColor: `${getStatusColor(orden.estado)}20`,
            color: getStatusColor(orden.estado),
          }}>{orden.estado}</span
        >
        {
          orden.mercadoPagoId && (
            <div class="mt-3 text-base">
              MP ID: <span>{orden.mercadoPagoId}</span>
            </div>
          )
        }
      </div>

      <!-- Cliente -->
      {
        orden.cliente && (
          <div class="rounded p-6 bg-[#0a0a0a] border border-[#1a1a1a]">
            <h3 class="text-xs tracking-[0.2em] mb-6 text-[#666666]">
              Cliente
            </h3>
            <div class="flex flex-col gap-3">
              <span class="text-base tracking-[0.2em] text-white">
                {orden.cliente.nombre} {orden.cliente.apellido}
              </span>
              <div class="flex items-center gap-2">
                <span class="text-xs tracking-[0.2em] text-[#666666] flex items-center gap-1">
                  <Mail color="#ff0000" size={16} />

                  {orden.cliente.email}
                </span>
                <button>
                  <Copy size={14} />
                </button>
              </div>

              {orden.cliente.telefono && (
                <div class="flex items-center gap-2">
                  <span class="text-xs tracking-[0.2em] text-[#666666] flex items-center gap-1">
                    <Phone color="#ff0000" size={16} />
                    {orden.cliente.telefono}
                  </span>
                  <button>
                    <Copy size={14} />
                  </button>
                </div>
              )}
            </div>
          </div>
        )
      }

      <!-- Envío -->
      {
        orden.datosEnvio && (
          <div class="rounded p-6 bg-[#0a0a0a] border border-[#1a1a1a]">
            <h3 class="text-xs tracking-[0.2em] mb-6 text-[#666666]">Envío</h3>
            <div class="flex flex-col gap-1.5">
              <div class="flex items-center gap-1">
                <Truck size={16} color="#ff0000" />
                <span class="text-base capitalize">
                  {orden.datosEnvio.metodo}
                </span>
              </div>

              <span class="text-xs tracking-[0.2em] text-[#666666]">
                {orden.datosEnvio.nombreDestinatario}
              </span>
              <span class="text-xs tracking-[0.2em] text-[#666666]">
                {orden.datosEnvio.direccion.calle}{" "}
                {orden.datosEnvio.direccion.numero}
              </span>
              <span class="text-xs tracking-[0.2em] text-[#666666]">
                {orden.datosEnvio.direccion.ciudad},{" "}
                {orden.datosEnvio.direccion.provincia}
              </span>
              <span class="text-xs tracking-[0.2em] text-[#666666]">
                CP {orden.datosEnvio.direccion.codigoPostal}
              </span>
              {orden.datosEnvio.trackingId && (
                <span class="mt-2 text-ash">
                  Tracking: {orden.datosEnvio.trackingId}
                </span>
              )}
            </div>
            {orden.datosEnvio.metodo !== "retiro" && (
              <form
                class="flex flex-col items-end gap-3 mt-3"
                id="tracking-form"
              >
                <input
                  type="text"
                  name="trackingId"
                  class="input-field"
                  placeholder="Número de seguimiento"
                  value={orden.datosEnvio.trackingId ?? ""}
                />
                <button
                  type="submit"
                  class="btn border p-4 border-[#ff0000] hover:bg-[#ff0000] transition-colors"
                >
                  Guardar tracking
                </button>
              </form>
            )}
          </div>
        )
      }
    </div>
  </div>
</AdminLayout>

<script>
  // @ts-nocheck
  const header = document.getElementById("orden-header");
  const ordenId = header?.dataset.ordenId;

  async function actualizarEstadoOrden(id: string, estado: string) {
    const formData = new FormData();
    formData.set("estado", estado);
    const res = await fetch(`/api/admin/ordenes/${id}/estado`, {
      method: "POST",
      body: formData,
    });
    if (!res.ok) {
      throw new Error("No se pudo actualizar el estado");
    }
  }

  async function guardarNotaOrden(id: string, nota: string) {
    const formData = new FormData();
    formData.set("nota", nota);
    const res = await fetch(`/api/admin/ordenes/${id}/nota`, {
      method: "POST",
      body: formData,
    });
    if (!res.ok) {
      throw new Error("No se pudo guardar la nota");
    }
  }

  async function actualizarTrackingOrden(id: string, trackingId: string) {
    const formData = new FormData();
    formData.set("trackingId", trackingId);
    const res = await fetch(`/api/admin/ordenes/${id}/tracking`, {
      method: "POST",
      body: formData,
    });
    if (!res.ok) {
      throw new Error("No se pudo actualizar el tracking");
    }
  }

  if (ordenId) {
    const estadoButtons = document.querySelectorAll(
      "#estado-buttons [data-estado]",
    );
    estadoButtons.forEach((btn) => {
      btn.addEventListener("click", async (event) => {
        const target = event.currentTarget as HTMLElement;
        const estado = target.dataset.estado ?? null;
        if (!estado) return;
        try {
          await actualizarEstadoOrden(ordenId, estado);
          window.location.reload();
        } catch (error) {
          alert("Error al actualizar el estado de la orden");
        }
      });
    });

    const notaFormEl = document.getElementById("nota-form");
    if (notaFormEl instanceof HTMLFormElement) {
      notaFormEl.addEventListener("submit", async (event) => {
        event.preventDefault();
        const formData = new FormData(notaFormEl);
        const nota = (formData.get("nota") || "").toString().trim();
        if (!nota) {
          alert("La nota no puede estar vacía");
          return;
        }
        try {
          await guardarNotaOrden(ordenId, nota);
          window.location.reload();
        } catch (error) {
          alert("Error al guardar la nota");
        }
      });
    }

    const trackingFormEl = document.getElementById("tracking-form");
    if (trackingFormEl instanceof HTMLFormElement) {
      trackingFormEl.addEventListener("submit", async (event) => {
        event.preventDefault();
        const formData = new FormData(trackingFormEl);
        const trackingId = (formData.get("trackingId") || "").toString().trim();
        try {
          await actualizarTrackingOrden(ordenId, trackingId);
          window.location.reload();
        } catch (error) {
          alert("Error al actualizar el tracking");
        }
      });
    }
  }
</script>
