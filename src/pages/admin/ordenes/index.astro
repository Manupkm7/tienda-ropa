---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { db } from '../../lib/db';
import { ordenes } from '../../lib/db/schema';
import { eq, desc, ilike, and, or } from 'drizzle-orm';

const params = Astro.url.searchParams;
const estadoFiltro = params.get('estado') ?? '';
const pagina = parseInt(params.get('pagina') ?? '1');
const porPagina = 20;

const conds: any[] = [];
if (estadoFiltro) conds.push(eq(ordenes.estado, estadoFiltro));

const todas = await db.query.ordenes.findMany({
  where: conds.length ? and(...conds) : undefined,
  orderBy: [desc(ordenes.creadoEn)],
  with: { cliente: true },
  limit: porPagina,
  offset: (pagina - 1) * porPagina,
});

const fmt = (n: number) =>
  new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(n);

const fmtFecha = (d: Date) =>
  new Intl.DateTimeFormat('es-AR', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' }).format(d);

const ESTADOS = ['', 'pendiente', 'pagado', 'procesando', 'empaquetado', 'enviado', 'entregado', 'cancelado'];
---

<AdminLayout title="Órdenes">

  <!-- Filtros estado -->
  <div style="display:flex; gap:8px; margin-bottom:24px; flex-wrap:wrap;">
    {ESTADOS.map(e => (
      <a
        href={`/admin/ordenes${e ? `?estado=${e}` : ''}`}
        class="btn btn-sm btn-ghost"
        style={estadoFiltro === e ? 'border-color:#F5F2ED; color:#F5F2ED;' : ''}
      >
        {e || 'Todas'}
      </a>
    ))}
  </div>

  <div class="card">
    <table>
      <thead>
        <tr>
          <th>Nº</th>
          <th>Cliente</th>
          <th>Items</th>
          <th>Envío</th>
          <th>Estado</th>
          <th>Total</th>
          <th>Fecha</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {todas.length === 0 && (
          <tr><td colspan="8" style="text-align:center; color:#333; padding:32px;">Sin órdenes</td></tr>
        )}
        {todas.map(orden => (
          <tr>
            <td style="font-family:monospace; color:#F5F2ED; white-space:nowrap;">
              #{String(orden.numero).padStart(4, '0')}
            </td>
            <td>
              <div>{orden.cliente ? `${orden.cliente.nombre} ${orden.cliente.apellido}` : '—'}</div>
              <div style="font-size:11px; color:#333;">{orden.cliente?.email}</div>
            </td>
            <td style="font-size:11px;">{(orden.items ?? []).length} item(s)</td>
            <td style="font-size:11px; color:#555;">
              {orden.datosEnvio?.metodo === 'retiro'
                ? 'Retiro'
                : orden.datosEnvio?.metodo
                  ? orden.datosEnvio.metodo.charAt(0).toUpperCase() + orden.datosEnvio.metodo.slice(1)
                  : '—'
              }
            </td>
            <td>
              <span class={`badge badge-${orden.estado}`}>{orden.estado}</span>
            </td>
            <td style="font-family:monospace; color:#F5F2ED; white-space:nowrap;">
              {fmt(parseFloat(orden.total))}
            </td>
            <td style="font-size:11px; white-space:nowrap;">{fmtFecha(orden.creadoEn)}</td>
            <td>
              <a href={`/admin/ordenes/${orden.id}`} class="btn btn-ghost btn-sm">Ver →</a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

</AdminLayout>
