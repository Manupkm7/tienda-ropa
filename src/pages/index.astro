---
import Layout from "../components/layout/Layout.astro";
import ProductoCard from "../components/catalogo/ProductoCard.astro";
import { obtenerProductos } from "../lib/productos";
import { db } from "../lib/db";
import { categorias } from "../lib/db/schema";
import { eq } from "drizzle-orm";

const { productos: destacados } = await obtenerProductos({
  soloDestacados: true,
  porPagina: 4,
});
const cats = await db.query.categorias.findMany({
  where: eq(categorias.activa, true),
  orderBy: (c, { asc }) => [asc(c.orden)],
  limit: 5,
});
---

<Layout
  title="Tienda"
  description="Indumentaria de diseño — minimalismo en cada prenda"
>
  <!-- Categorías -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-20">
    <p class="label-sm mb-8">Explorar por categoría</p>
    <div class="flex flex-wrap gap-3">
      {
        cats.map((cat) => (
          <a
            href={`/productos?categoria=${cat.slug}`}
            class="px-6 py-3 border border-dust text-sm hover:border-ink hover:bg-ink hover:text-bone
                 transition-all duration-200 tracking-wide"
          >
            {cat.nombre}
          </a>
        ))
      }
      <a
        href="/productos"
        class="px-6 py-3 border border-dust text-sm text-ash hover:text-ink hover:border-ink
               transition-all duration-200 tracking-wide"
      >
        Ver todo →
      </a>
    </div>
  </section>

  <!-- Productos destacados -->
  {
    destacados.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-24">
        <div class="flex justify-between items-baseline mb-8">
          <p class="label-sm">Destacados</p>
          <a
            href="/productos?soloDestacados=true"
            class="text-xs text-ash hover:text-ink transition-colors"
          >
            Ver todos →
          </a>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-x-4 gap-y-8">
          {destacados.map((prod, i) => (
            <ProductoCard producto={prod} index={i} />
          ))}
        </div>
      </section>
    )
  }

  <!-- Banner intermedio -->
  <section class="border-y border-[#ff0000] text-bone py-20 px-4 sm:px-6">
    <div
      class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-8 select-none"
    >
      <div>
        <h2 class="heading-lg mb-3">Envíos por Andreani y OCA</h2>
        <p class="text-bone/60 max-w-md">
          A todo el país. Calculamos el costo en el checkout según tu dirección.
        </p>
      </div>
      <a
        href="/productos"
        class="btn-outline border-[#ff0000]/30 text-bone hover:bg-[#ff0000] hover:text-ink flex-shrink-0"
      >
        Explorar
      </a>
    </div>
  </section>

  <!-- Features -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-20">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-10">
      {
        [
          {
            icon: "○",
            titulo: "Materiales premium",
            desc: "Seleccionamos cada tela con criterio. Calidad sobre cantidad.",
          },
          {
            icon: "△",
            titulo: "Envíos a todo el país",
            desc: "Andreani y OCA. Seguimiento en tiempo real.",
          },
          {
            icon: "□",
            titulo: "Devoluciones fáciles",
            desc: "30 días para cambios. Sin preguntas, sin complicaciones.",
          },
        ].map(({ icon, titulo, desc }) => (
          <div>
            <p class="text-2xl mb-4 text-dust">{icon}</p>
            <h3 class="text-sm font-medium mb-2">{titulo}</h3>
            <p class="text-sm text-ash leading-relaxed">{desc}</p>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
