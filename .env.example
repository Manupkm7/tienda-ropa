# ─── Supabase ────────────────────────────────────────────────
# Obtener en: https://supabase.com/dashboard/project/_/settings/api
# y en:       https://supabase.com/dashboard/project/_/settings/database

# URL de conexión directa a PostgreSQL (para Drizzle ORM)
# Ir a: Settings → Database → Connection string → URI
# Usar puerto 5432 (directo), NO 6543 (pooler) para Drizzle
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# URL y claves del proyecto Supabase (para Storage)
# Ir a: Settings → API
SUPABASE_URL=https://[REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# service_role key — solo en server, nunca exponer al cliente

# ─── MercadoPago ─────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000

# ─── App ─────────────────────────────────────────────────────
SITE_URL=http://localhost:4321

# ─── Admin ───────────────────────────────────────────────────
ADMIN_JWT_SECRET=un-string-muy-largo-y-aleatorio-de-al-menos-32-caracteres

# ─── Auth usuarios (clientes) ────────────────────────────────
USER_JWT_SECRET=otro-string-largo-y-aleatorio-distinto-al-admin

# ─── Andreani ────────────────────────────────────────────────
ANDREANI_USER=tu_usuario
ANDREANI_PASS=tu_password
ANDREANI_CLIENT_NUMBER=tu_numero_cliente

# ─── OCA ─────────────────────────────────────────────────────
OCA_CUIT=20-00000000-0
OCA_USER=tu_usuario@empresa.com
OCA_PASS=tu_password
